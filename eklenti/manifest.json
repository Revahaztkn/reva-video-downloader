{
  "manifest_version": 3,
  "name": "Reva Video Downloader",
  "version": "1.0.4",
  "description": "YouTube, X, Instagram ve TikTok videolarını 480p veya 720p olarak kaydet.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "icons": {"16":"icons/reva-16.png","32":"icons/reva-32.png","48":"icons/reva-48.png","128":"icons/reva-128.png"},
  "action": {
    "default_title": "Reva Video Downloader",
    "default_icon": {"16":"icons/reva-16.png","32":"icons/reva-32.png","48":"icons/reva-48.png"},
    "default_popup": "popup.html"
  },
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://*.youtube.com/*", "https://*.x.com/*", "https://*.twitter.com/*", "https://*.instagram.com/*", "https://*.tiktok.com/*"],
    "js": ["links.js", "content.js"],
    "all_frames": true
  }]
}

